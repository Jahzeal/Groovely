      <td><strong>Voice Synthesis (10 sec audio)</strong></td>
      <td>$0.0040</td>
      <td>5 Credits</td>
      <td>$0.025</td>
      <td class="badge-green">84.0% Margin</td>
    </tr>
    <tr>
      <td><strong>Beat Generation (30 sec clip)</strong></td>
      <td>$0.0120</td>
      <td>12 Credits</td>
      <td>$0.060</td>
