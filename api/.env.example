# NestJS Backend Environment Variables

PORT=5000
NODE_ENV=development

# Database Connection
DATABASE_URL=postgresql://username:password@localhost:5432/grovely_db

# Authentication Security
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production

# Frontend Client URL
CLIENT_URL=http://localhost:3000

# Google OAuth Integration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Cloudinary Integration (for media/avatar uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
