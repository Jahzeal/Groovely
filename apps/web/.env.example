# Groovely Web Frontend Environment Variables Example

# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Blockchain & Smart Contract Configuration
# Polygon Mainnet (137) or Polygon Amoy Testnet (80002)
NEXT_PUBLIC_CHAIN_ID=137
NEXT_PUBLIC_CONTRACT_ADDRESS=your_contract_address_here
NEXT_PUBLIC_USDC_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# WalletConnect, Privy & ZeroDev Account Abstraction
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here
NEXT_PUBLIC_ZERODEV_PROJECT_ID=your_zerodev_project_id_here
